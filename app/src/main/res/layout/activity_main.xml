<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Input Nomor"
        android:textSize="30sp"
        android:padding="20dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:background="#30E5FF"/>

    <EditText
        android:id="@+id/nomor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="phone"
        android:hint="Nomor"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="10dp"
        android:autofillHints="phone"/>

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp">
        <RadioButton
            android:id="@+id/rumah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telepon Rumah"/>
        <RadioButton
            android:id="@+id/kantor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telepon Kantor"/>
        <RadioButton
            android:id="@+id/pribadi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telepon Pribadi"/>
    </RadioGroup>

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#30E5FF"
        android:paddingVertical="15dp"
        android:text="Submit"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:cornerRadius="0dp"/>

</LinearLayout>